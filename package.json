{
    "name": "SLR Translator",
    "description": "SLR, RPGM translation tool.",
    "main": "main.js",
    "homepage": "",
    "version": "3.082",
    "author": "Shisaye",
    "license": "GPL-3.0-or-later",
    "chromium-args": "--mixed-context --enable-spell-checking --disable-web-security --disable-features=nw2 --memory-pressure-off --force-dark-mode --user-data-dir=./data/profile",
    "window": {
        "width": 880,
        "height": 600,
        "icon": "icon.png"
    },
    "inject_js_start": "www/js/preload.js",
    "dependencies": {
        "@alenaksu/json-viewer": "^0.2.0",
        "7zip-min": "^1.1.1",
        "acorn": "^8.1.1",
        "acorn-loose": "^8.1.0",
        "async-lz-string": "^1.0.3",
        "async-wait-until": "^2.0.12",
        "await-fs": "^1.0.0",
        "codepage": "^1.15.0",
        "comment-parser": "^1.4.0",
        "create-require": "^1.1.1",
        "debounce": "^1.2.1",
        "detect-file-encoding-and-language": "^2.3.1",
        "dragselect": "^1.13.1",
        "encoding-japanese": "^1.0.30",
        "fs-extra": "^9.0.0",
        "glob": "^8.1.0",
        "glob-to-regexp": "^0.4.1",
        "iconv-lite": "^0.5.1",
        "ini": "^3.0.1",
        "is-valid-path": "^0.1.1",
        "jpeg-js": "^0.4.4",
        "jquery": "^1.12.3",
        "jquery-csv": "^1.0.21",
        "js-ini": "^1.5.1",
        "js-tokens": "^6.0.0",
        "jschardet": "^3.0.0",
        "jsonata": "^2.0.3",
        "kstg": "^0.7.0",
        "module-alias": "^2.2.2",
        "nspell": "^2.1.5",
        "p-limit": "^3.1.0",
        "pako": "^2.0.4",
        "pngjs": "^7.0.0",
        "postman-request": "^2.88.1-postman.28",
        "promisify-child-process": "^4.1.1",
        "regexp-match-indices": "^1.0.2",
        "shell-escape": "^0.2.0",
        "string-argv": "^0.3.1",
        "strip-bom": "^4.0.0",
        "win-version-info": "^6.0.1",
        "windows-elevate": "^1.0.1",
        "windows-shortcuts": "^0.1.6",
        "ws": "^8.2.2"
    },
    "show": false,
    "localConfig": {
        "logToFile": true,
        "configFile": "data/config.json",
        "defaultTemplate": "data/template.json",
        "ruby": "ruby/bin/ruby",
        "php": "php/bin/php",
        "llama": "runtime",
        "addons": "www/addons",
        "core": "www/core",
        "defaultStagingPath": "www/php/cache",
        "extensions": [
            "slrproj"
        ],
        "iconIndex": {
            "slrproj": 3
        },
        "defaultIconIndex": 3,
        "versionHistory": "",
        "checkVersion": "not-always",
        "defaultDocsUrl": ""
    },
    "scripts": {
        "test": "node --test www/core/SLRtrans/lib/TranslationEngine/tests/*.test.js www/core/SLRtrans/lib/TranslationEngine/review/tests/*.test.js www/core/SLRbatch/tests/*.test.js www/js/tests/*.test.js www/core/llmRuntime/tests/*.test.js www/core/docsChat/tests/*.test.js",
        "build-doc": "jsdoc -c jsdoc.json"
    }
}
